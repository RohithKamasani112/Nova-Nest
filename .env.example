# AWS S3 Configuration (REQUIRED)
VITE_AWS_ACCESS_KEY_ID=your_aws_access_key_here
VITE_AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
VITE_AWS_REGION=us-east-1
VITE_S3_BUCKET_NAME=your-property-bucket-name
VITE_S3_FOLDER_NAME=properties

# Environment Mode
VITE_PRODUCTION=false

# Optional: Application Name (for branding)
VITE_APP_NAME=My-Properties

# Optional: API Endpoints (if needed for future expansion)
VITE_API_BASE_URL=https://api.example.com
VITE_IMAGE_CDN_URL=https://cdn.example.com

# Dummy Data Configuration
# Set to true to enable dummy property data in the application
# When true, dummy properties from S3 will be visible alongside real properties
# When false, only real user-created properties are shown
VITE_DUMMY_DATA=true
