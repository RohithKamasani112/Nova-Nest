# Amplify/frontend: PUBLIC configuration only. Never add AWS credentials here.
VITE_CRM_API_BASE_URL=https://YOUR_EXISTING_CRM_FUNCTION_URL/api
VITE_SITE_URL=https://novanest.co.in
VITE_IS_PRODUCTION=true
# Optional legacy storage metadata; the backend S3_FOLDER is authoritative.
VITE_AWS_REGION=us-east-1
VITE_S3_BUCKET_NAME=YOUR_EXISTING_BUCKET
VITE_S3_FOLDER_PROD=YOUR_EXISTING_SITE_FOLDER
VITE_S3_FOLDER_DUMMY=YOUR_EXISTING_DUMMY_FOLDER

# Backend/local deployment only. Do NOT put these in Amplify frontend settings.
LAMBDA_FUNCTION_NAME=YOUR_EXISTING_MAIN_CRM_LAMBDA
AWS_REGION=YOUR_EXISTING_CRM_LAMBDA_REGION
DATABASE_URL=REPLACE_LOCALLY_WITH_ROTATED_DATABASE_URL
JWT_SECRET=REPLACE_LOCALLY_WITH_A_NEW_RANDOM_SECRET
S3_BUCKET_NAME=YOUR_EXISTING_BUCKET
S3_REGION=us-east-1
S3_FOLDER=YOUR_EXISTING_SITE_FOLDER
ALLOWED_ORIGINS=https://novanest.co.in,https://www.novanest.co.in,https://YOUR_BRANCH.YOUR_APP_ID.amplifyapp.com
