# ============================================================================
# ⚠️  SECURITY WARNING — READ BEFORE SETTING AWS KEYS
# ----------------------------------------------------------------------------
# Vite inlines every VITE_-prefixed variable into the CLIENT JS bundle at build
# time. Any value below is shipped to every visitor's browser in plaintext and
# can be read from DevTools. A long-lived AWS secret key here WILL be stolen.
#
#   * NEVER put a production AWS secret in VITE_AWS_SECRET_ACCESS_KEY for a
#     public/deployed build. `npm run build` runs a scanner that FAILS the build
#     if it finds an AWS key in dist/ (scripts/check-bundle-secrets.mjs).
#   * Use an IAM key scoped to ONLY this S3 bucket, for local/dev use only.
#   * Renaming these to non-VITE_ names keeps them OUT of the bundle, but then
#     the browser cannot read them either — S3 calls must then run server-side.
#     That is the real fix: a backend/Cognito. See SECURITY.md.
# ============================================================================

# AWS S3 Configuration
# Local/dev only. Scope this IAM user to a single bucket; rotate if ever exposed.
VITE_AWS_ACCESS_KEY_ID=your_aws_access_key_here
VITE_AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
VITE_AWS_REGION=us-east-1
VITE_S3_BUCKET_NAME=your-property-bucket-name
VITE_S3_FOLDER_NAME=properties

# Environment Mode
VITE_PRODUCTION=false

# Optional: Application Name (for branding)
VITE_APP_NAME=Nova Nest Property Management

# Business identity used on printed/exported documents (currently the admin
# "Generate Bill" letterhead)
VITE_BUSINESS_NAME=Nova Nest Property Management
VITE_BUSINESS_ADDRESS=Ground Floor, Site No-29&30, Meshwarama Temple, 1st Main Rd, Maheswari Nagar, B Narayanapura, Mahadevapura, Bengaluru, Karnataka 560048
VITE_BUSINESS_PHONE=096637 95675

# Optional: API Endpoints (if needed for future expansion)
VITE_API_BASE_URL=https://api.example.com
VITE_IMAGE_CDN_URL=https://cdn.example.com

# Google Maps JavaScript API key (Places library enabled), used by the admin
# property form's address autocomplete + locality/lat-lng auto-detection.
# Restrict this key by HTTP referrer in the Google Cloud Console — like the
# other VITE_-prefixed values above, it ships in the client bundle by design.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Dummy Data Configuration
# Set to true to enable dummy property data in the application
# When true, dummy properties from S3 will be visible alongside real properties
# When false, only real user-created properties are shown
VITE_DUMMY_DATA=true

# Google Analytics 4
# Single source of truth for the GA4 measurement ID. Used in index.html (base
# gtag.js snippet, inlined at build time) and src/utils/analytics.ts (page views).
# IMPORTANT: also set this in the AWS Amplify console → Environment variables so
# it is present in the production build.
VITE_GA_MEASUREMENT_ID=G-B7PPPMGMFL
